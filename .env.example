# ---------------------------------------------------------------------------
# Aethon Intelligence — VSL funnel configuration
# Copy to .env.local for local development. On Vercel, set these in
# Project Settings → Environment Variables.
# The page renders cleanly (poster video state, booking fallback) when any of
# these are unset — nothing silently breaks.
# ---------------------------------------------------------------------------

# Canonical URL of the deployed funnel (used for metadata / Open Graph).
NEXT_PUBLIC_SITE_URL=https://funnel.aethonintelligence.com

# --- Vidalytics videos (one per page) ---------------------------------------
# Each video needs two values from its Vidalytics embed snippet:
#   <div id="vidalytics_embed_XXXXXXXX"> ...
#   <script src="https://fast.vidalytics.com/embeds/<account>/<video>/loader.min.js">
# Set the id (the part after "vidalytics_embed_") and the loader.min.js URL.
# Any video left unset renders a branded poster instead — nothing breaks.

# Main landing page VSL (5–10 min)
NEXT_PUBLIC_VIDALYTICS_EMBED_ID=
NEXT_PUBLIC_VIDALYTICS_LOADER_URL=

# /confirm preparation video (~3 min)
NEXT_PUBLIC_VIDALYTICS_EMBED_ID_CONFIRM=
NEXT_PUBLIC_VIDALYTICS_LOADER_URL_CONFIRM=

# /faq pre-second-call video
NEXT_PUBLIC_VIDALYTICS_EMBED_ID_FAQ=
NEXT_PUBLIC_VIDALYTICS_LOADER_URL_FAQ=

# --- Cal.com booking --------------------------------------------------------
# The Cal.com link slug, i.e. the part after cal.com/ in your booking URL.
# Example: NEXT_PUBLIC_CAL_LINK=jahan/walkthrough
NEXT_PUBLIC_CAL_LINK=

# Post-booking redirect override (defaults to /confirm — normally leave unset).
# IMPORTANT: because the main-page CTA links to the Cal.com booking page
# directly, you must ALSO set "Redirect on booking" to the /confirm URL in the
# Cal.com event type settings for the redirect to happen for those visitors.
NEXT_PUBLIC_CAL_REDIRECT_URL=
